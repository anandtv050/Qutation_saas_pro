# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_quotation_saas_pro
DB_USER=postgres
DB_PASSWORD=your-db-password

# Application Configuration
APP_ENV=development
APP_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# JWT Configuration — generate a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# AI Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-google-app-password   # Not your Gmail password — Google App Password

# Telegram Bot — leave empty to disable. When set, the bot starts with the API server.
# Get a token from @BotFather on Telegram. Bot: @your_bot_username
TELEGRAM_BOT_TOKEN=
