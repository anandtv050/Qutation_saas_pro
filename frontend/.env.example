# Backend API URL
# For local development: http://localhost:5000
# For production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Lead Helper on marketing pages (misc/lead-helper/README.md). Build-time: redeploy after changing.
# Kill switch: the helper only runs when this is exactly "on".
VITE_LEAD_HELPER=off
# Google Apps Script web app URL (ends in /exec). Empty = nothing is logged; the helper still works.
VITE_LEAD_SHEET_URL=
# Google Sign-In OAuth Web client ID (same value as backend GOOGLE_CLIENT_ID). Empty = Google option hidden.
VITE_GOOGLE_CLIENT_ID=
